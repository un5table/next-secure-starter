// Generalized starter schema. The auth models match the Auth.js v5 Prisma adapter.
// `Note` is an example owned resource demonstrating the ownership pattern
// (authenticated owner OR guest proven by a hashed token). Replace it with your
// own domain models — keep the auth + AuditLog + AppSetting spine.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

// ---------- Auth.js v5 Prisma adapter models ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)

  accounts Account[]
  sessions Session[]
  notes    Note[]    @relation("NoteOwner")

  // Local credentials (argon2id). Null for OAuth-only users.
  passwordHash      String?
  // Watermark used to invalidate JWTs after a password reset (see src/auth.ts).
  passwordChangedAt DateTime?

  invitesSent         UserInvite[]         @relation("InviteCreator")
  passwordResetTokens PasswordResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// Present for the adapter; unused with the JWT session strategy.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Example owned resource ----------

model Note {
  id    String  @id @default(cuid())
  title String
  body  String?

  // Ownership: authenticated user OR guest proven by a hashed manage token.
  ownerId        String?
  owner          User?   @relation("NoteOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerTokenHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

// ---------- Admin invites & password reset ----------

model UserInvite {
  id          String    @id @default(cuid())
  email       String
  role        Role      @default(USER)
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String
  createdBy   User      @relation("InviteCreator", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([email])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// ---------- App-wide settings & audit ----------

model AppSetting {
  id                   String   @id @default(cuid())
  // Kill-switch for unauthenticated writes (e.g. guest resource creation).
  allowGuestWrites     Boolean  @default(true)
  // Comma-separated list of enabled OAuth provider ids, e.g. "google,github".
  enabledAuthProviders String   @default("")
  updatedAt            DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String // csp-violation | rate-limit-hit | password-reset-requested | password-reset-completed | invite-accepted
  ip        String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([action])
  @@index([createdAt])
}
