# Copy to .env.local and fill in. Never commit real secrets.
# The Neon + Upstash Vercel Marketplace integrations auto-provision the DB/KV vars
# in deployed environments — you only need these locally.

# ── Database (any Postgres) ────────────────────────────────────────
# Works with any Postgres host — the driver adapter is picked from the URL
# (Neon's serverless driver for *.neon.tech, node-postgres otherwise).
#   Local Docker:  docker run -d --name pg -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres:17
#   then:          DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres?sslmode=disable"
# On Neon, DATABASE_URL is the pooled URL and DATABASE_URL_UNPOOLED the direct one
# (used for migrations); on a plain Postgres you can omit DATABASE_URL_UNPOOLED.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres?sslmode=disable"
DATABASE_URL_UNPOOLED=""

# ── Auth.js v5 ─────────────────────────────────────────────────────
# Generate: `npx auth secret`  (or `openssl rand -base64 32`)
AUTH_SECRET="replace-with-a-32+-char-random-secret"
# Public base URL (used to build email links). Set per environment.
AUTH_URL="http://localhost:3000"

# ── OAuth providers (optional — each self-disables if unset) ───────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ── Rate limiting (Upstash Redis / Vercel KV) ──────────────────────
# Without these, rate limiting is a no-op locally (open). Required in production.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# ── Cloudflare Turnstile (guest-write CAPTCHA) ─────────────────────
# Without the secret, verification is skipped locally.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ── Arcjet (shield + bot detection + rate limiting) ────────────────
# Get a free key at https://app.arcjet.com. Without it, guest endpoints fall back
# to the Upstash rate limiter, so this is optional locally.
ARCJET_KEY=""

# ── Sentry (error monitoring) ──────────────────────────────────────
# Without a DSN, Sentry is fully disabled. The auth token (+ org/project) is only
# needed to upload source maps at build (also flip "@sentry/cli" to true in
# pnpm-workspace.yaml).
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# ── Email (Resend) ─────────────────────────────────────────────────
# Without the API key, emails log to the console instead of sending.
RESEND_API_KEY=""
RESEND_FROM="Secure Starter <onboarding@resend.dev>"

# ── Cron ───────────────────────────────────────────────────────────
CRON_SECRET="replace-with-a-random-secret"

# ── Branding ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Secure Starter"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BRAND_COLOR="#2563eb"

# ── Dev only (never set in Vercel) ─────────────────────────────────
# Lets the dev credentials provider sign you in with any email + this password.
DEV_PASSWORD="dev"

# Set to 1 to skip env validation (e.g. Docker image builds, CI lint-only steps).
# SKIP_ENV_VALIDATION=1
